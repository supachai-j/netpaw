{
  "mcpServers": {
    "subnet-calc": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/_shared/proxy.py",
        "--expect-sha256",
        "87707a28dc49bfe2aeab96e2726254418af7a8793de4f430dcfaa70cb56de6ca",
        "--cache",
        "${CLAUDE_PLUGIN_ROOT}/mcp/subnet-calc/tools.cache.json",
        "--",
        "uv",
        "run",
        "--quiet",
        "--no-project",
        "--isolated",
        "--with",
        "mcp==1.30.0",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/subnet-calc/server.py"
      ],
      "env": {}
    },
