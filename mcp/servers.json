{
  "subnet-calc": {
    "command": "python3",
    "args": [
      "{root}/mcp/_shared/proxy.py",
      "--expect-sha256",
      "87707a28dc49bfe2aeab96e2726254418af7a8793de4f430dcfaa70cb56de6ca",
      "--cache",
      "{root}/mcp/subnet-calc/tools.cache.json",
      "--",
      "uv",
      "run",
      "--quiet",
      "--no-project",
      "--isolated",
      "--with",
      "mcp==1.30.0",
      "python",
      "{root}/mcp/subnet-calc/server.py"
    ],
    "env": {},
    "capability": "read",
    "egress": []
  },
